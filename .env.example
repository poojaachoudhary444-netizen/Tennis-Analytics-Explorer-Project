# Copy this file to ".env" and fill in your own values. NEVER commit ".env" to GitHub.

# Free trial key: https://console.sportradar.com/signup  (Tennis v3 API)
SPORTRADAR_API_KEY=your_api_key_here
SPORTRADAR_ACCESS_LEVEL=trial

# --- Database (choose ONE) ---
# SQLite (default, zero setup):
DATABASE_URL=sqlite:///tennis.db
# MySQL:
# DATABASE_URL=mysql+pymysql://tennis_user:your_password@localhost:3306/tennis_db
# PostgreSQL (pip install psycopg2-binary):
# DATABASE_URL=postgresql+psycopg2://tennis_user:your_password@localhost:5432/tennis_db
